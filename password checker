password = input("Enter password: ")

length = len(password) >= 8
upper = False
lower = False
number = False
special = False

for ch in password:
    if ch.isupper():
        upper = True
    elif ch.islower():
        lower = True
    elif ch.isdigit():
        number = True
    else:
        special = True

print("\nPassword Analysis")
print("At least 8 characters:", length)
print("Contains uppercase letter:", upper)
print("Contains lowercase letter:", lower)
print("Contains a number:", number)
print("Contains special character:", special)

score = length + upper + lower + number + special

if score <= 2:
    print("\nStrength: WEAK")
elif score <= 4:
    print("\nStrength: MEDIUM")
else:
    print("\nStrength: STRONG")
