expenses = []

while True:
    print("\n1. Add Expense")
    print("2. View Expenses")
    print("3. Show Summary")
    print("4. Exit")

    choice = input("Enter choice: ")

    if choice == "1":
        amount = float(input("Amount: "))
        category = input("Category: ")
        description = input("Description: ")

        expenses.append([amount, category, description])
        print("Expense added!")

    elif choice == "2":
        print("\nExpenses:")
        for e in expenses:
            print(e[0], "-", e[1], "-", e[2])

    elif choice == "3":
        total = 0
        categories = {}

        for e in expenses:
            total += e[0]

            if e[1] in categories:
                categories[e[1]] += e[0]
            else:
                categories[e[1]] = e[0]

        print("\nTotal spent:", total)

        for category in categories:
            print(category, ":", categories[category])

        if categories:
            highest = max(categories, key=categories.get)
            print("Most spent on:", highest)

    elif choice == "4":
        print("Goodbye!")
        break

    else:
        print("Invalid choice")
